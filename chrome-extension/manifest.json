{
  "manifest_version": 3,
  "name": "Lumina — Convert Last Answer",
  "version": "1.0.0",
  "description": "Paste the Convert Last Answer prompt into ChatGPT, Gemini, or Claude and submit.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ]
}
